# Flame-cn 配置示例
#
# 这个文件说明 compose.yaml 里会用到的变量。它**不会**被自动读取 —— 按你的使用方式二选一：
#
#   ▸ 命令行用户：
#       cp .env.example .env.local       # 然后编辑 .env.local
#       docker compose --env-file .env.local up -d
#     (.env.local 已被 .gitignore 忽略，密码不会进 Git)
#
#   ▸ 面板用户（Arcane / Portainer / Dockge 等）：
#     不要用 --env-file —— 面板不会传这个参数。
#     直接把下面的变量填到面板里：
#       · Arcane：Customization → Variables（会写到 .env.global，compose 会自动解析），
#                 或直接编辑项目目录里的 .env
#       · Portainer/Dockge：在 stack 的环境变量编辑区里添加
#
# 等号后面不要加引号、不要留多余空格。

# ───────────── 必填 ─────────────
# 登录密码。请改成足够强的密码。
# 若不设置，容器会退回默认值 flame_password —— 那是不安全的。
FLAME_PASSWORD=please-change-me

# ───────────── 常用（都有默认值，可整行删除） ─────────────
# 对外端口，默认 5005
#FLAME_PORT=5005

# 数据目录（config / SQLite / uploads / themes）。
# 命令行默认 ./flame-data；面板用户建议改成绝对路径，例如 /srv/flame-data
#DATA_DIR=./flame-data

# 使用的镜像 tag，默认跟随当前正式版本。
# 可选 ghcr.io/willfunniers/flame-cn 上的任一 tag，例如 latest
#FLAME_VERSION=v2.4.0-zh.3

# ───────────── 和风天气 QWeather（可选，不用就整段留空/删除） ─────────────
# 完整步骤见 README 的「QWeather」章节。
#
# 私钥目录：compose 会把这个目录只读挂到容器的 /run/secrets
#   命令行：保持默认（把 PEM 放进 compose.yaml 旁的 secrets/）
#   面板用户：改成宿主机绝对路径，私钥就不必放进面板的项目目录
#QWEATHER_SECRETS_DIR=./secrets
#QWEATHER_SECRETS_DIR=/srv/flame-secrets

# 只用 JWT（推荐）：取消下面几行注释并填写
#QWEATHER_API_HOST=你的专属APIHost
#QWEATHER_AUTH_MODE=jwt
#QWEATHER_KEY_ID=凭据ID
#QWEATHER_DEVELOPER_ID=开发者ID
#QWEATHER_PROJECT_ID=项目ID
#QWEATHER_PRIVATE_KEY_PATH=/run/secrets/ed25519-private.pem

# 只用 API Key（兼容方式）
#QWEATHER_AUTH_MODE=api-key
#QWEATHER_API_KEY=你的Key
