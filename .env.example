# Flame-cn 配置示例
#
# 用法：
#   cp .env.example .env.local
#   # 编辑 .env.local（至少设置 FLAME_PASSWORD）
#   docker compose --env-file .env.local up -d --build
#
# .env.local 已被 .gitignore 忽略，**不会**被提交到 Git。
# 等号后面不要加引号、不要留多余空格。

# ───────────── 必填 ─────────────
# 登录密码。请改成足够强的密码。
# 若不设置，容器会退回 Dockerfile 里的默认值 flame_password —— 那是不安全的。
FLAME_PASSWORD=please-change-me

# ───────────── 常用（都有默认值，可整行注释掉） ─────────────
# 对外端口，默认 5005
#FLAME_PORT=5005
# 数据目录（config / SQLite / uploads / themes）。
# 建议改成磁盘上的固定绝对路径，例如 /srv/flame-data
#DATA_DIR=./flame-data
# 本地构建产物的镜像 tag，默认跟随当前版本
#FLAME_VERSION=v2.4.0-zh.3

# ───────────── 和风天气 QWeather（可选，不用就整段留空/删除） ─────────────
# 只用 JWT（推荐）：把私钥放到 ./secrets/ 下，取消下面几行注释并填写
#QWEATHER_API_HOST=你的专属APIHost
#QWEATHER_AUTH_MODE=jwt
#QWEATHER_KEY_ID=凭据ID
#QWEATHER_DEVELOPER_ID=开发者ID
#QWEATHER_PROJECT_ID=项目ID
#QWEATHER_PRIVATE_KEY_PATH=/run/secrets/ed25519-private.pem

# 只用 API Key（兼容方式）
#QWEATHER_AUTH_MODE=api-key
#QWEATHER_API_KEY=你的Key
